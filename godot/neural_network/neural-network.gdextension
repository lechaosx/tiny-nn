[configuration]

entry_symbol = "init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

windows.debug.x86_32   = "res://neural_network/libneural-network.windows.template_debug.x86.dll"
windows.release.x86_32 = "res://neural_network/libneural-network.windows.template_release.x86.dll"
windows.debug.x86_64   = "res://neural_network/libneural-network.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://neural_network/libneural-network.windows.template_release.x86_64.dll"
linux.debug.x86_64     = "res://neural_network/libneural-network.linux.template_debug.x86_64.so"
linux.release.x86_64   = "res://neural_network/libneural-network.linux.template_release.x86_64.so"
linux.debug.arm64      = "res://neural_network/libneural-network.linux.template_debug.aarch64.so"
linux.release.arm64    = "res://neural_network/libneural-network.linux.template_release.aarch64.so"
linux.debug.rv64       = "res://neural_network/libneural-network.linux.template_debug.riscv64.so"
linux.release.rv64     = "res://neural_network/libneural-network.linux.template_release.riscv64.so"
android.debug.x86_64   = "res://neural_network/libneural-network.android.template_debug.x86_64.so"
android.release.x86_64 = "res://neural_network/libneural-network.android.template_release.x86_64.so"
android.debug.arm64    = "res://neural_network/libneural-network.android.template_debug.aarch64.so"
android.release.arm64  = "res://neural_network/libneural-network.android.template_release.aarch64.so"
web.debug              = "res://neural_network/libneural-network.web.template_debug.wasm"
web.release            = "res://neural_network/libneural-network.web.template_release.wasm"